# Copy to .env.local for local dev. In deployed environments, NEXT_PUBLIC_*
# vars are baked in at image build time (see carrieros-web/Dockerfile's
# --build-arg list); server-only vars are injected at container runtime via
# AWS Secrets Manager (see architecture/deployment.md). Never commit real values.

# --- Supabase (required) -----------------------------------------------------
# Local: run `supabase status` for these. Hosted: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS -- never expose to the client, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# Public origin of this deployment; used to build links in invoice emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domain for per-org load-intake addresses (loads@<org>.<domain>).
LOAD_EMAIL_DOMAIN=carrierosapp.com

# --- AI / LLM provider (decisions.md T17) -------------------------------------
# lib/ai/ resolves each provider's key DB-first (an encrypted key set via the
# SuperAdmin /admin/ai-config page, sx_owner only), falling back to the matching
# env var below when no encrypted key is stored. Only the active provider
# (ai_provider_config.provider, default 'openai') actually needs a key at
# runtime, but any of the three may be set here for local dev.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional -- many self-hosted/open-source endpoints (Ollama, vLLM, LM Studio)
# require no key at all.
OPENAI_COMPATIBLE_API_KEY=

# --- Shared secrets (generate: openssl rand -hex 32) -------------------------
# Protects POST /api/cron/send-reminders. Route refuses to run if unset.
CRON_SECRET=
# Protects the inbound load-intake webhook.
INTAKE_WEBHOOK_SECRET=
# Signs /api/public/v1 access tokens (public developer API, Phase 9). Route
# refuses to issue or verify tokens if unset.
PUBLIC_API_JWT_SECRET=
# AES-256-GCM key (lib/crypto/secrets.ts) encrypting/decrypting LLM provider API
# keys stored in ai_provider_config (migration 0032, decisions.md T17's
# 2026-09-22 amendment) -- real one-time infrastructure, set once. Routes/
# providers that need it throw a typed error if it's unset; without it, only
# the env-var-fallback path above works (no DB-stored key can be set or read).
SECRETS_ENCRYPTION_KEY=

# --- Email (optional locally: defaults to Supabase's local Mailpit) ----------
# Required in staging/production, e.g. Resend's SMTP endpoint.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="CarrierOS <no-reply@yourdomain.com>"

# --- Error tracking (Sentry; entirely inert until a DSN is set) --------------
# SENTRY_DSN=                    server + edge runtimes
# NEXT_PUBLIC_SENTRY_DSN=        browser (same DSN is fine; it is not a secret)
# SENTRY_ENVIRONMENT=staging     tag events per environment
# Build-time only, enables source-map upload for readable stack traces:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
