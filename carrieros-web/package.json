{
  "name": "carrieros-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "verify:compliance": "eslint && tsc --noEmit && node scripts/check-architecture.mjs && node scripts/check-tokens.mjs && npm run check:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extraction": "vitest run --config vitest.extraction.config.ts",
    "test:support-triage": "vitest run --config vitest.support-triage.config.ts",
    "gen:api": "tsx scripts/gen-api-client.ts",
    "check:api": "tsx scripts/gen-api-client.ts --check",
    "test:audit": "vitest run -c vitest.audit.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@sentry/nextjs": "^10.75.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "next-intl": "^4.13.2",
    "nodemailer": "^9.0.3",
    "openai": "^7.21.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
