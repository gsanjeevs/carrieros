#!/usr/bin/env bash
# Versioned git hook (see CLAUDE.md "Gated checks" — enable once per clone with
# `git config core.hooksPath scripts/git-hooks`). This repo has no CI, so this
# hook is the actual enforcement mechanism for docs/architecture-principles.md
# and docs/design/carrieros-design-system.md, not just documentation.
#
# Fast checks only (no DB) — full test suite runs in pre-push instead, so
# commits stay quick.
set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

WEB_FILES=$(echo "$STAGED" | grep -E '^carrieros-web/.*\.(ts|tsx)$' || true)
if [ -n "$WEB_FILES" ]; then
  echo "→ carrieros-web: eslint"
  (cd carrieros-web && npx eslint $(echo "$WEB_FILES" | sed 's|^carrieros-web/||'))

  echo "→ carrieros-web: tsc --noEmit (no incremental cache)"
  (cd carrieros-web && npx tsc --noEmit --incremental false)

  echo "→ carrieros-web: architecture check (Rule B/D/G decoupling)"
  (cd carrieros-web && node scripts/check-architecture.mjs)
fi

MOBILE_FILES=$(echo "$STAGED" | grep -E '^carrieros-mobile/.*\.(ts|tsx)$' || true)
if [ -n "$MOBILE_FILES" ]; then
  echo "→ carrieros-mobile: tsc --noEmit"
  (cd carrieros-mobile && npx tsc --noEmit)
fi

# Token sync check (scripts/check-tokens.mjs) — fires when EITHER app's
# palette-source file is staged, not just when *.ts/*.tsx under
# carrieros-web/ changes: app/globals.css is .css (missed by WEB_FILES
# above), and a mobile-only edit to constants/theme.ts must also be checked
# against web's @theme block, the source of truth.
TOKEN_FILES=$(echo "$STAGED" | grep -E '^(carrieros-web/app/globals\.css|carrieros-web/lib/design-tokens\.ts|carrieros-mobile/src/constants/theme\.ts)$' || true)
if [ -n "$TOKEN_FILES" ]; then
  echo "→ token sync check (globals.css ↔ design-tokens.ts ↔ mobile theme.ts)"
  (cd carrieros-web && node scripts/check-tokens.mjs)
fi

# Migration-number collision check (cheap, no DB needed) — two coding sessions in this repo (see
# CLAUDE.md "Multiple LLM sessions working on this repo at once") have already independently picked
# the same "next" migration number once. Sequential/unique numbering across supabase/migrations/*.sql
# is a hard requirement (scripts/db/migrate.mjs applies them in order), so this is a real block, not a
# nudge — catches the collision here instead of at merge/push time or, worse, after both are applied.
MIGRATION_FILES=$(echo "$STAGED" | grep -E '^supabase/migrations/.*\.sql$' || true)
MIGRATION_CHANGES=$(git diff --cached --name-status -- supabase/migrations/)
if [ -n "$MIGRATION_CHANGES" ]; then
  echo "→ applied-migration immutability check"
  EDITED_MIGRATIONS=$(echo "$MIGRATION_CHANGES" | awk '$1 ~ /^[MDRTU]/ { print }')
  if [ -n "$EDITED_MIGRATIONS" ]; then
    echo "✗ Existing migration files are immutable once committed:"
    echo "$EDITED_MIGRATIONS" | sed 's/^/    /'
    echo "  Add a new, uniquely numbered migration to fix forward; do not edit, delete, or rename an applied migration."
    exit 1
  fi
fi

if [ -n "$MIGRATION_FILES" ]; then
  echo "→ migration number collision check"
  DUPES=$(ls supabase/migrations/*.sql | xargs -n1 basename | grep -oE '^[0-9]+' | sort | uniq -d)
  if [ -n "$DUPES" ]; then
    echo "✗ Duplicate migration number(s): $DUPES"
    echo "  Another session likely picked the same number. Re-check the real latest number"
    echo "  (\`ls supabase/migrations | sort -V | tail -3\` or \`git fetch\`) and renumber before committing."
    exit 1
  fi
fi

# Shared-hub-file nudge (non-blocking) — see CURRENT_WORK.md and CLAUDE.md "Multiple LLM sessions":
# these specific files are the ones repeatedly edited by more than one coding session and are where
# real merge friction has actually happened (hand-picking hunks out of schema.sql, etc.) — a plain
# reminder here is cheap and catches the case where a session forgot to check CURRENT_WORK.md first.
HUB_FILES=$(echo "$STAGED" | grep -E '^(supabase/schema/schema\.sql|supabase/migrations/.*\.sql|carrieros-web/lib/generated/role-capabilities\.ts|carrieros-mobile/src/lib/generated/role-capabilities\.ts|carrieros-web/messages/.*\.json)$' || true)
if [ -n "$HUB_FILES" ]; then
  echo "ℹ Committing a change to a file other coding sessions may also be editing:"
  echo "$HUB_FILES" | sed 's/^/    /'
  echo "  Checked/updated CURRENT_WORK.md (repo root)?"
fi

echo "✓ pre-commit checks passed"
