# Copy to .env for local dev. EXPO_PUBLIC_* values are compiled into the app
# bundle and are visible to anyone who has the app: only put the anon key and
# public URLs here, never the service-role key. For EAS builds these come from
# the profile in eas.json (or EAS environment variables), not this file.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of carrieros-web, for the few calls that go through its /api routes.
EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_SENTRY_DSN=
