{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "development" }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_SUPABASE_URL": "https://ddwgnsheafuuzzepqxsf.supabase.co",
        "EXPO_PUBLIC_API_URL": "https://ca-aa167deb702e4a338c4370ff70576195.ecs.us-east-1.on.aws"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SUPABASE_URL": "REPLACE_WITH_PRODUCTION_SUPABASE_URL",
        "EXPO_PUBLIC_API_URL": "REPLACE_WITH_PRODUCTION_WEB_URL"
      }
    }
  },
  "submit": { "production": {} }
}
